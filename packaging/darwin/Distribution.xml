<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="2">
  <title>MyGittu @VERSION@ 安装程序</title>
  <welcome file="welcome.html"/>
  <conclusion file="conclusion.html"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
  <volume-check><allowed-os-versions><os-version min="13.0"/></allowed-os-versions></volume-check>
  <choices-outline><line choice="default"/></choices-outline>
  <choice id="default" visible="false" title="MyGittu"><pkg-ref id="dev.mygittu.desktop"/></choice>
  <pkg-ref id="dev.mygittu.desktop" version="@VERSION@" onConclusion="none">MyGittu-component.pkg</pkg-ref>
</installer-gui-script>
