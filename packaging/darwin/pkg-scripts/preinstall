#!/bin/bash
set -euo pipefail

target="${3:-/}"
bin="${target%/}/Applications/MyGittu.app/Contents/MacOS"

running() {
  /bin/ps -ww -axo pid=,comm= | MYGITTU_EXECUTABLE="$1" /usr/bin/awk '
    { pid = $1; sub(/^[[:space:]]*[0-9]+[[:space:]]+/, ""); if ($0 == ENVIRON["MYGITTU_EXECUTABLE"]) print pid }
  '
}

stop() {
  local executable="$1" pid attempt
  for pid in $(running "$executable"); do
    kill -TERM "$pid" 2>/dev/null || true
  done
  for attempt in {1..30}; do
    [[ -n "$(running "$executable")" ]] || return 0
    sleep 0.1
  done
  for pid in $(running "$executable"); do
    kill -KILL "$pid" 2>/dev/null || true
  done
  for attempt in {1..20}; do
    [[ -n "$(running "$executable")" ]] || return 0
    sleep 0.1
  done
  echo "Could not stop MyGittu process: $executable" >&2
  return 1
}

# Close desktop clients first so they cannot keep using or restart the Agent.
stop "$bin/desktop"
stop "$bin/agent"
